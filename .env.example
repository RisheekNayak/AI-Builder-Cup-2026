# ==========================================
# ShipSure — Environment Variables Template
# ==========================================
# Copy this file to '.env' and fill in your credentials to run the app.

# ------------------------------------------
# Mode Selection
# ------------------------------------------
# Set to 'false' to use real Google Cloud APIs.
# Set to 'true' to use local mock data (no GCP credentials required).
DEMO_MODE=true

# ------------------------------------------
# Google Cloud Credentials
# ------------------------------------------
# 1. Your Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# 2. Path to your Service Account JSON key file
# E.g., ./gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=

# 3. Location (usually 'us' or 'us-central1')
GCP_LOCATION=us-central1

# ------------------------------------------
# Document AI Configuration (Phase 2)
# ------------------------------------------
# The ID of your Document AI "Invoice Parser" Processor
GCP_PROCESSOR_ID=your-processor-id

# ------------------------------------------
# Vertex AI Search (Phase 2)
# ------------------------------------------
# The Datastore ID containing the Trade Policy PDFs
GCP_DATASTORE_ID=your-datastore-id

# Development-only database reset. Leave disabled on public deployments.
ENABLE_DEMO_RESET=false
# Required in X-Demo-Reset-Token when reset is explicitly enabled.
DEMO_RESET_TOKEN=

# Durable storage (leave local defaults for development)
SHIPSURE_STORAGE_BACKEND=local
# Required for gcs; objects remain private and downloads go through the API.
SHIPSURE_STORAGE_BUCKET=
SHIPSURE_STORAGE_PREFIX=shipsure/demo
# Cloud SQL IAM auth; service-account DB username omits .gserviceaccount.com
SHIPSURE_CLOUD_SQL_INSTANCE=
SHIPSURE_DB_USER=
SHIPSURE_DB_NAME=shipsure

# Free-quota prototype state store; activation requires importing existing demo first.
SHIPSURE_DATABASE_BACKEND=sqlite
SHIPSURE_FIRESTORE_DATABASE=(default)
